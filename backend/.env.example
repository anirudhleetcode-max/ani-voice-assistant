# Copy to .env and fill in. NEVER commit the real file — it is git-ignored.
#
# The whole reason this service exists is that these values must not ship inside an APK.
# An API key in an Android app is an API key handed to everyone who downloads it, and no
# amount of obfuscation, NDK storage or string-splitting changes that.

# Which provider answers. One of: anthropic, openai, echo
ANI_PROVIDER=anthropic

# Anthropic
ANI_ANTHROPIC_API_KEY=
ANI_ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (only read when ANI_PROVIDER=openai)
ANI_OPENAI_API_KEY=
ANI_OPENAI_MODEL=gpt-4o-mini

# Requests allowed per install id per minute.
ANI_RATE_LIMIT_PER_MINUTE=20

# Hard cap on reply length, in tokens. Ani is meant to be brief.
ANI_MAX_TOKENS=200
